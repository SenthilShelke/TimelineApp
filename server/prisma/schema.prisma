// Prisma schema for TimelineApp
// Design notes:
// - `User` has NO password column. Credentials live in `AuthIdentity`.
// - Email/password login = an AuthIdentity row with provider="password" and a
//   bcrypt hash in `secret`.
// - Google SSO (added later) = an AuthIdentity row with provider="google",
//   providerUserId = Google "sub", and secret = null. No schema change needed.
// - timelines -> events -> event_images is the normalized data hierarchy,
//   all anchored to a User via foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  displayName   String?         @map("display_name")
  emailVerified Boolean         @default(false) @map("email_verified")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  identities    AuthIdentity[]
  timelines     Timeline[]

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String // "password" | "google" | ...
  providerUserId String   @map("provider_user_id")
  secret         String? // bcrypt hash for "password"; null for SSO
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Timeline {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]

  @@index([userId])
  @@map("timelines")
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  timelineId  String       @map("timeline_id") @db.Uuid
  title       String
  eventDate   DateTime     @map("event_date") @db.Date
  description String?
  position    Int?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  timeline    Timeline     @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  images      EventImage[]

  @@index([timelineId])
  @@map("events")
}

model EventImage {
  id       String  @id @default(uuid()) @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  url      String // local file:// URI for now; remote URL once uploads land
  position Int?

  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_images")
}
